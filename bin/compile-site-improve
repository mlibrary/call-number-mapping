#!/usr/bin/env php
<?php

$pages = json_decode(file_get_contents("/var/www/templates/site-improve.json"), true);

mkdir("/var/www/html/site-improve", 0755, true);
foreach ($pages as $page) {
  $pid = pcntl_fork();
  if ($pid == -1) {
    die("Could not fork");
  } elseif ($pid == 0) {
    // Child process
    // Setup superglobals from $page
    $_SERVER = [];
    $_GET = [];
    $_POST = [];
    foreach ($page['_SERVER'] as $key => $value) {
      $_SERVER[$key] = $value;
    }
    foreach ($page['_GET'] as $key => $value) {
      $_GET[$key] = $value;
    }
    foreach ($page['_POST'] as $key => $value) {
      $_POST[$key] = $value;
    }
    // Load the stub database before the page autoloads the real one.
    // The stub defines \Umich\CallNumberMapping\Database in-process using
    // SQLite :memory: so no live database connection is required.
    require_once '/var/www/src/StubDatabase.php';
    ob_start();
    include($page["source"]);
    $output = ob_get_clean();
    // Save the output to a file
    file_put_contents($page["target"], $output);
    exit(0);
  } else {
    // Parent process
    pcntl_wait($status); // Wait for the child process to finish
    print("Finished processing: {$page["name"]}\n");
  }
}

// Generate sitemap from the source URLs in site-improve.json.
// Each entry's source path is mapped to a canonical URL by stripping the
// /var/www/html prefix and prepending the base URL.  GET parameters are
// included so that parameterised views (search results, topic views, etc.)
// each get their own <url> entry.  Entries whose source would map to the
// same URL+query are deduplicated.

$base_url = 'https://cnm.dnd.lib.umich.edu';
$doc_root  = '/var/www/html';

$seen = [];
$urls = [];

foreach ($pages as $page) {
  $path = $page['source'];
  if (strpos($path, $doc_root) === 0) {
    $path = substr($path, strlen($doc_root));
  }
  $loc = $base_url . $path;
  if (!empty($page['_GET'])) {
    $loc .= '?' . http_build_query($page['_GET']);
  }
  if (!isset($seen[$loc])) {
    $seen[$loc] = true;
    $urls[] = $loc;
  }
}

$xml  = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n";
$xml .= "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n";
foreach ($urls as $loc) {
  $xml .= "  <url>\n";
  $xml .= "    <loc>";
  $xml .= htmlspecialchars($loc, ENT_XML1 | ENT_QUOTES, 'UTF-8');
  $xml .= "</loc>\n";
  $xml .= "  </url>\n";
}
$xml .= "</urlset>\n";

$sitemap_path = $doc_root . '/site-improve/sitemap_cnm.dnd.xml';
file_put_contents($sitemap_path, $xml);
print("Wrote sitemap: {$sitemap_path}\n");
