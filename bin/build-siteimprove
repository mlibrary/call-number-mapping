#!/usr/bin/env php
<?php

$pages = json_decode(file_get_contents("/var/www/templates/siteimprove.json"), true);

if (!file_exists("/var/www/html/siteimprove")) {
  print("Creating directory: /var/www/html/siteimprove\n");
  mkdir("/var/www/html/siteimprove", 0755, true);
}

$base_url = 'https://cnm.dnd.lib.umich.edu';
$doc_root = '/var/www/html';
$sitemap_path = $doc_root . '/siteimprove/sitemap_cnm.dnd.xml';
$sitemap  = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n";
$sitemap .= "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n";

foreach ($pages as $page) {
  $pid = pcntl_fork();
  if ($pid == -1) {
    die("Could not fork");
  } elseif ($pid == 0) {
    // Child process
    // Setup superglobals from $page
    $_SERVER = [];
    $_GET = [];
    $_POST = [];
    foreach ($page['_SERVER'] as $key => $value) {
      $_SERVER[$key] = $value;
    }
    foreach ($page['_GET'] as $key => $value) {
      $_GET[$key] = $value;
    }
    foreach ($page['_POST'] as $key => $value) {
      $_POST[$key] = $value;
    }
    // Load the stub database before the page autoloads the real one.
    // The stub defines \Umich\CallNumberMapping\Database in-process using
    // SQLite :memory: so no live database connection is required.
    require_once '/var/www/src/StubDatabase.php';
    ob_start();
    @include($page["source"]);
    $output = ob_get_clean();
    // Save the output to a file
    file_put_contents($page["target"], $output);
    exit(0);
  } else {
    // Parent process
    pcntl_wait($status); // Wait for the child process to finish
    print("Finished processing: {$page["name"]}\n");

    $path = $page['target'];
    if (strpos($path, $doc_root) === 0) {
      $path = substr($path, strlen($doc_root));
    }
    $loc = $base_url . $path;
    $sitemap .= "  <url>\n";
    $sitemap .= "    <loc>";
    $sitemap .= htmlspecialchars($loc, ENT_XML1 | ENT_QUOTES, 'UTF-8');
    $sitemap .= "</loc>\n";
    $sitemap .= "  </url>\n";
  }
}

$sitemap .= "</urlset>\n";
file_put_contents($sitemap_path, $sitemap);
print("Wrote sitemap: {$sitemap_path}\n");
